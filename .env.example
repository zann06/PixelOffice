# Public frontend configuration only. These values are visible to browser users.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key

# NEVER put a Supabase service-role key, database password, OAuth client secret,
# signing secret, or other privileged credential in a VITE_* variable.
# Store privileged secrets only in server-side / Edge Function secret storage.
